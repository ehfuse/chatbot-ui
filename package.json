{
    "name": "@ehfuse/chatbot-ui",
    "version": "0.1.0",
    "description": "A React/MUI chatbot UI — chat drawer, streaming answers, feedback, and a knowledge management console",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "restricted"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "node build.mjs",
        "type-check": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ehfuse/chatbot-ui.git"
    },
    "keywords": [
        "react",
        "chatbot",
        "chat",
        "rag",
        "knowledge-base",
        "material-ui",
        "mui",
        "typescript"
    ],
    "author": "김영진 <ehfuse@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/ehfuse/chatbot-ui/issues"
    },
    "homepage": "https://github.com/ehfuse/chatbot-ui#readme",
    "peerDependencies": {
        "@ehfuse/alerts": ">=1.1.4",
        "@ehfuse/forma": ">=3.4.0",
        "@ehfuse/mui-form-controls": ">=3.1.0",
        "@ehfuse/mui-form-dialog": ">=1.7.51",
        "@ehfuse/overlay-scrollbar": ">=1.7.0",
        "@ehfuse/taskbox": ">=0.5.267",
        "@emotion/react": ">=11.0.0",
        "@emotion/styled": ">=11.0.0",
        "@mui/icons-material": ">=6.0.0",
        "@mui/material": ">=6.0.0",
        "entity-client": ">=1.0.31",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "react-markdown": ">=9.0.0",
        "react-virtuoso": ">=4.0.0",
        "remark-gfm": ">=4.0.0"
    },
    "devDependencies": {
        "@ehfuse/alerts": "^1.1.4",
        "@ehfuse/forma": "^3.4.0",
        "@ehfuse/mui-form-controls": "^3.2.5",
        "@ehfuse/mui-form-dialog": "^1.7.54",
        "@ehfuse/overlay-scrollbar": "^1.7.27",
        "@ehfuse/taskbox": "^0.5.276",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.4",
        "@mui/material": "^7.3.7",
        "@types/node": "^24.6.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "entity-client": "^1.0.31",
        "esbuild": "^0.27.0",
        "esbuild-plugin-d.ts": "^1.3.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-markdown": "^10.1.0",
        "react-virtuoso": "^4.14.1",
        "remark-gfm": "^4.0.1",
        "tslib": "^2.8.1",
        "typescript": "~5.9.3"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
